# LLM (optional: without a key CarbonOps uses rules, or replays recorded answers in Demo mode)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
REPLAY_MODE=off

# AWS emulator (moto). The app starts it itself on this port. Set CARBONOPS_AWS=real for a real account.
AWS_ENDPOINT_URL=http://localhost:5050
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_DEFAULT_REGION=ap-south-1
